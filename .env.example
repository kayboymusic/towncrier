# =========================================================
# Town Crier — environment template
# Copy this file to .env and fill values.
# Never commit .env.
# =========================================================

# --- Supabase ---------------------------------------------
# Create a project at https://supabase.com, then grab these
# from Project Settings → API.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Postgres connection string (Project Settings → Database).
# Used by the workers + api when talking directly to Postgres.
DATABASE_URL=

# --- Web (Next.js public env) -----------------------------
# Mirror of the values above that are safe to ship to the browser.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# --- AI providers -----------------------------------------
# At least ANTHROPIC_API_KEY + OPENAI_API_KEY are required
# for the default pipeline. XAI_API_KEY is optional.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
XAI_API_KEY=

# Provider routing (anthropic | openai | grok)
SUMMARY_PROVIDER=anthropic
CLASSIFY_PROVIDER=anthropic

# Model overrides (defaults are sensible)
ANTHROPIC_SUMMARY_MODEL=claude-sonnet-4-6
ANTHROPIC_CLASSIFY_MODEL=claude-haiku-4-5-20251001
OPENAI_SUMMARY_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
GROK_MODEL=grok-4

# --- Redis (Upstash) --------------------------------------
# Used for caching + a lightweight job stream.
# Create at https://upstash.com → Redis.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# --- Misc -------------------------------------------------
LOG_LEVEL=INFO
DEDUP_SIMILARITY_THRESHOLD=0.92
DEDUP_LOOKBACK_DAYS=7
